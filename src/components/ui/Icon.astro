    'M11.5 2.7a.6.6 0 0 1 1 0l2.5 5 5.5.8a.6.6 0 0 1 .3 1l-4 3.9.9 5.5a.6.6 0 0 1-.8.6L12 16.9l-4.9 2.6a.6.6 0 0 1-.8-.6l.9-5.5-4-3.9a.6.6 0 0 1 .3-1l5.5-.8z',
  ],
  /* Build process */
  'message-circle': ['M7.9 20A9 9 0 1 0 4 16.1L2 22z'],
  'file-text': [
    'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z',
    'M14 2v4a2 2 0 0 0 2 2h4',
    'M10 9H8',
    'M16 13H8',
    'M16 17H8',
