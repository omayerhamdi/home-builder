---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { formatAud } from '../../lib/format';
import smartSpecsImage from '../../assets/img/interiors/kitchen-galley.jpg';
import luxeImage from '../../assets/img/interiors/kitchen-island.jpg';

/**
 * The two specifications, side by side. Nobody else in this segment explains
 * their tiers on the homepage — the client's own site does not name them at
 * all — so this section does work no competitor is doing.
 */
const tiers = (await getCollection('tiers')).sort(
  (a, b) => a.data.priceFrom - b.data.priceFrom,
);

const art = {
  smartspecs: {
    image: smartSpecsImage,
    alt: 'Galley kitchen in a SmartSpecs home — stone benchtops, stainless appliances and timber-look flooring',
  },
  luxeturnkey: {
    image: luxeImage,
    alt: 'Kitchen and island bench in a LuxeTurnkey home — dark overhead cabinetry, 900mm cooktop and canopy rangehood',
  },
} as const;
---

<Section id="finish" band="surface" labelledby="finish-heading">
  <div class="max-w-prose">
    <Eyebrow>Two specifications</Eyebrow>
    <h2 id="finish-heading" class="mt-4 text-h2">
      Choose the finish. The price stays fixed.
    </h2>
    <p class="mt-5 text-lead text-ink-70">
      Every DBN home is <span class="num">7</span>-star energy rated with solar as
      standard.
    </p>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-8" data-reveal-group>
    {
      tiers.map((tier, i) => {
        const media = art[tier.id as keyof typeof art];
        return (
          <article class:list={['tier', i === 1 && 'is-complete']} data-reveal>
            <Picture
              src={media.image}
              alt={media.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 45vw, 100vw"
              quality={58}
              class="tier-image"
              loading="lazy"
              decoding="async"
            />

            <div class="tier-body">
              <div class="tier-head">
                <span class="tier-tag">{tier.data.tagline}</span>
                <h3 class="tier-name">{tier.data.name}</h3>
                <p class="tier-price">
                  <span class="num">From {formatAud(tier.data.priceFrom)}</span>
                  <span class="tier-price-note">{tier.data.priceNote}</span>
                </p>
              </div>

              <p class="tier-summary">{tier.data.summary}</p>

              <ul class="tier-list">
                {tier.data.inclusions.map((inclusion) => (
                  <li>
                    <Icon name="check" size={16} class="tier-check" />
                    <span>{inclusion}</span>
                  </li>
                ))}
              </ul>

              <Button class="mt-8" href={tier.data.cta.href} icon="arrow-right" full>
                {tier.data.cta.label}
              </Button>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="mt-8">
    <a class="schedule-link" href="/inclusions/#schedule">
      Full inclusions schedule (PDF)
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</Section>

<style>
  .tier {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .tier:hover {
    border-color: var(--color-rule-strong);
  }

  /* The complete tier carries a heavier top edge — a small, quiet signal that
     these two cards are not the same weight. */
  .is-complete {
    border-top: 3px solid var(--color-teal);
  }

  .tier-image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tier-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .tier-head {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .tier-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-55);
  }

  .is-complete .tier-tag {
    background-color: var(--color-teal);
    border-color: var(--color-teal);
    color: var(--color-surface);
  }

  .tier-name {
    margin-top: 0.875rem;
    font-size: var(--text-h3);
  }

  .tier-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 1.375rem;
    font-weight: 500;
  }

  .tier-price-note {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--color-ink-55);
  }

  .tier-summary {
    margin-top: 1.25rem;
    font-size: var(--text-body);
    color: var(--color-ink-70);
  }

  .tier-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .tier-list li {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    font-size: var(--text-small);
  }

  .tier-list :global(.tier-check) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-teal);
  }

  .schedule-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
