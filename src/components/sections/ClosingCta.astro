---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../lib/site';

/**
 * Closing call to action.
 *
 * Flat teal. A photograph here competed with the ask and washed out the
 * buttons; the band is separated from the footer below by tone alone —
 * `--teal` against the footer's `--teal-deep` — which is enough.
 */
---

<section id="get-a-price" class="closing" aria-labelledby="closing-heading">
  <div class="closing-inner">
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="lg:col-span-7">
          <h2 id="closing-heading" class="max-w-[18ch] text-h2">
            Tell us your block. We'll tell you the price.
          </h2>
          <p class="mt-5 max-w-prose text-lead text-white/80">
            A fixed price with the site costs already in it.
          </p>
        </div>

        <div class="closing-actions lg:col-span-5">
          <Button href="/build-a-quote/" tone="dark" icon="arrow-right"
            >Build a quote</Button
          >
          <Button href="/display-homes/" variant="secondary" tone="dark">
            Visit the display
          </Button>
          <a class="closing-phone num" href={site.phoneHref}>
            <Icon name="phone" size={18} />
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    background-color: var(--color-teal);
    color: var(--color-surface);
  }

  .closing-inner {
    padding-block: var(--spacing-section);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .closing-actions {
      justify-content: flex-end;
    }
  }

  .closing-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding-inline: 0.5rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
