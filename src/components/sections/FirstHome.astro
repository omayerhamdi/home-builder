---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import {
  FHOG_CAP,
  STAMP_DUTY_EXEMPT_CAP,
  formatAudCompact,
  isFhogEligible,
  isStampDutyExempt,
  packageFromPrice,
} from '../../lib/format';

/**
 * First home buyers.
 *
 * The two thresholds are the whole story, so they are drawn rather than
 * described: one axis, the two eligibility bands shaded on it, and every
 * package in the inventory plotted as a tick. A visitor sees in one glance
 * where the range sits relative to $600,000 and $750,000 — which is exactly
 * the question they came with.
 *
 * It is the same visual language as the dimension line: an axis, hairlines,
 * mono labels. Counts and tick positions are computed from the data.
 */
const packages = (await getCollection('packages')).map((entry) => entry.data);
const prices = packages.map(packageFromPrice).sort((a, b) => a - b);

const exemptCount = prices.filter(isStampDutyExempt).length;
const grantCount = prices.filter(isFhogEligible).length;

/* Axis bounds, rounded out to clean $50k stops around the real range. */
const AXIS_MIN = Math.floor(Math.min(...prices, STAMP_DUTY_EXEMPT_CAP) / 50_000) * 50_000;
const AXIS_MAX = Math.ceil(Math.max(...prices, FHOG_CAP) / 50_000) * 50_000;
const pos = (value: number) => ((value - AXIS_MIN) / (AXIS_MAX - AXIS_MIN)) * 100;

const ticks: number[] = [];
for (let value = AXIS_MIN; value <= AXIS_MAX; value += 50_000) ticks.push(value);
---

<Section id="first-home-buyers" band="surface" labelledby="fhb-heading">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Eyebrow>Victorian first home buyers</Eyebrow>
      <h2 id="fhb-heading" class="mt-4 text-h2">
        <span class="num">$10,000</span> grant. <span class="num">$0</span> stamp duty under{
          ' '
        }
        <span class="num">$600,000</span>.
      </h2>
      <p class="mt-6 max-w-prose text-lead text-ink-70">
        Most of our packages qualify. We flag eligibility on each listing, before you
        enquire.
      </p>

      <Button class="mt-8" href="/house-and-land/?price=0-600000" icon="arrow-right">
        See packages under <span class="num">$600,000</span>
      </Button>

      <p class="mt-6 max-w-prose text-small text-ink-55">
        Indicative only. Eligibility is assessed by the State Revenue Office.
      </p>
    </div>

    <div class="lg:col-span-7">
      <div class="scale" data-reveal>
        <div class="scale-legend">
          <p class="scale-legend-item">
            <span class="scale-swatch is-exempt" aria-hidden="true"></span>
            <span>
              <span class="num scale-count">{exemptCount}</span> pay no stamp duty
            </span>
          </p>
          <p class="scale-legend-item">
            <span class="scale-swatch is-grant" aria-hidden="true"></span>
            <span>
              <span class="num scale-count">{grantCount}</span> qualify for the grant
            </span>
          </p>
        </div>

        <div class="scale-plot">
          <div
            class="scale-band is-exempt"
            style={`left:0%;width:${pos(STAMP_DUTY_EXEMPT_CAP)}%`}
          >
            <span class="num scale-band-label">$0 stamp duty</span>
          </div>
          <div
            class="scale-band is-grant"
            style={`left:${pos(STAMP_DUTY_EXEMPT_CAP)}%;width:${pos(FHOG_CAP) - pos(STAMP_DUTY_EXEMPT_CAP)}%`}
          >
            <span class="num scale-band-label">$10,000 grant</span>
          </div>

          <ul class="scale-ticks">
            {
              prices.map((price) => (
                <li
                  class:list={[
                    'scale-tick',
                    isStampDutyExempt(price) && 'is-exempt',
                    !isFhogEligible(price) && 'is-over',
                  ]}
                  style={`left:${pos(price)}%`}
                />
              ))
            }
          </ul>

          <div class="scale-axis"></div>

          <ul class="scale-scale">
            {
              ticks.map((value) => (
                <li class="num scale-stop" style={`left:${pos(value)}%`}>
                  {formatAudCompact(value)}
                </li>
              ))
            }
          </ul>
        </div>

        <p class="scale-note">
          Every package we list, plotted by its lowest advertised price.
        </p>
      </div>
    </div>
  </div>
</Section>

<style>
  .scale {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background-color: var(--color-paper);
  }

  .scale-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .scale-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-70);
  }

  .scale-count {
    font-weight: 500;
    color: var(--color-ink);
  }

  .scale-swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: var(--radius-sm);
  }

  .scale-swatch.is-exempt {
    background-color: rgb(142 59 46 / 0.16);
    box-shadow: inset 0 2px 0 var(--color-brick);
  }

  .scale-swatch.is-grant {
    background-color: rgb(31 59 50 / 0.1);
    box-shadow: inset 0 2px 0 var(--color-teal);
  }

  /* -------------------------------------------------------------- Plot */
  .scale-plot {
    position: relative;
    height: 8.5rem;
  }

  .scale-band {
    position: absolute;
    top: 0;
    bottom: 2.75rem;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .scale-band.is-exempt {
    background-color: rgb(142 59 46 / 0.1);
    box-shadow: inset 0 2px 0 var(--color-brick);
  }

  .scale-band.is-grant {
    background-color: rgb(31 59 50 / 0.06);
    box-shadow: inset 0 2px 0 rgb(31 59 50 / 0.55);
  }

  .scale-band-label {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    right: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink-70);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Each package, plotted. The ticks are the evidence behind the counts. */
  .scale-ticks {
    position: absolute;
    inset: 0 0 2.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scale-tick {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 2.25rem;
    background-color: var(--color-teal);
    opacity: 0.5;
    transform: translateX(-0.5px);
  }

  .scale-tick.is-exempt {
    background-color: var(--color-brick);
    opacity: 0.75;
    height: 2.75rem;
  }

  .scale-tick.is-over {
    opacity: 0.25;
  }

  .scale-axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2.75rem;
    height: 1px;
    background-color: var(--color-ink);
    opacity: 0.5;
  }

  .scale-scale {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scale-stop {
    position: absolute;
    top: 0.5rem;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    color: var(--color-ink-55);
    white-space: nowrap;
  }

  .scale-stop::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 50%;
    width: 1px;
    height: 0.3125rem;
    background-color: var(--color-ink);
    opacity: 0.4;
  }

  .scale-note {
    margin-top: 1.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-55);
  }
</style>
