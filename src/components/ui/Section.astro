---
/**
 * Section shell.
 *
 * Owns the band rhythm so that no two adjacent sections ever land on the same
 * background: paper → surface → limestone → paper, with teal reserved for
 * the closing call to action and the footer.
 */
interface Props {
  id: string;
  band: 'paper' | 'surface' | 'limestone' | 'teal';
  labelledby?: string;
  width?: 'content' | 'bleed';
  tight?: boolean;
  class?: string;
}

const {
  id,
  band,
  labelledby,
  width = 'content',
  tight = false,
  class: className = '',
} = Astro.props;

const bands = {
  paper: 'bg-paper text-ink',
  surface: 'bg-surface text-ink',
  limestone: 'bg-limestone text-ink',
  teal: 'bg-teal text-surface',
} as const;

/* Two options only: on the container, or full-bleed. There is no middle
   width — see the container note in theme.css. */
const widths = {
  content: 'mx-auto max-w-content px-gutter',
  bleed: '',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[bands[band], tight ? 'py-section-tight' : 'py-section', className]}
>
  <div class={widths[width]}>
    <slot />
  </div>
</section>
