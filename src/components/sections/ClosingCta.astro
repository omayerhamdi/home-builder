---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import backdrop from '../../assets/img/estates/home-on-lot-aerial.jpg';
import { site } from '../../lib/site';

/**
 * Closing call to action.
 *
 * Set on photography under a deep forest wash rather than a flat forest fill.
 * The footer directly below is flat and darker, so the two dark bands read as
 * two distinct surfaces instead of one long slab — and the last thing a
 * visitor sees before the small print is a finished DBN home on its lot.
 */
---

<section id="get-a-price" class="closing" aria-labelledby="closing-heading">
  <Picture
    src={backdrop}
    alt=""
    formats={['avif']}
    fallbackFormat="webp"
    widths={[768, 1200, 1600]}
    sizes="100vw"
    quality={52}
    pictureAttributes={{ class: 'closing-picture' }}
    class="closing-image"
    loading="lazy"
    decoding="async"
  />
  <div class="closing-wash"></div>

  <div class="closing-inner">
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="lg:col-span-7">
          <h2 id="closing-heading" class="max-w-[18ch] text-h2">
            Tell us your block. We'll tell you the price.
          </h2>
          <p class="mt-5 max-w-prose text-lead text-white/80">
            A fixed price with the site costs already in it.
          </p>
        </div>

        <div class="closing-actions lg:col-span-5">
          <Button href="/build-a-quote/" tone="dark" icon="arrow-right"
            >Build a quote</Button
          >
          <Button href="/display-homes/" variant="glass" tone="dark">
            Visit the display
          </Button>
          <a class="closing-phone num" href={site.phoneHref}>
            <Icon name="phone" size={18} />
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    background-color: var(--color-forest);
    color: var(--color-surface);
    isolation: isolate;
  }

  .closing-picture {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .closing-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .closing-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        100deg,
        rgb(22 43 37 / 0.95) 0%,
        rgb(22 43 37 / 0.86) 45%,
        rgb(22 43 37 / 0.66) 100%
      ),
      linear-gradient(to bottom, rgb(22 43 37 / 0.35), rgb(22 43 37 / 0.7));
  }

  .closing-inner {
    padding-block: var(--spacing-section);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .closing-actions {
      justify-content: flex-end;
    }
  }

  .closing-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding-inline: 0.5rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
