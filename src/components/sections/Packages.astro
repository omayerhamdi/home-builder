---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import PackageCard from '../cards/PackageCard.astro';
import { packageFromPrice } from '../../lib/format';

const [packages, designs, estates] = await Promise.all([
  getCollection('packages'),
  getCollection('designs'),
  getCollection('estates'),
]);

const designName = new Map(designs.map((d) => [d.data.id, d.data.name]));
const rows = packages.map((entry) => entry.data);

/* Estates that actually hold packages, busiest first. The tab set is derived
   from the inventory — an estate with nothing in it never appears. */
const estateTabs = estates
  .map((entry) => ({
    ...entry.data,
    count: rows.filter((p) => p.estate === entry.data.id).length,
  }))
  .filter((e) => e.count > 0)
  .sort((a, b) => b.count - a.count);

const estateName = new Map(estateTabs.map((e) => [e.id, e.name]));
const DEFAULT_ESTATE = estateTabs[0]!.id;
const PER_ESTATE = 3;

/* Verified records first, then cheapest — the cards a visitor sees first are
   the ones whose numbers came from a public listing. */
const featured = estateTabs.flatMap((estate) =>
  rows
    .filter((pkg) => pkg.estate === estate.id)
    .sort((a, b) => {
      if (a.verified !== b.verified) return a.verified ? -1 : 1;
      return packageFromPrice(a) - packageFromPrice(b);
    })
    .slice(0, PER_ESTATE),
);
---

<Section id="house-and-land" band="surface" labelledby="packages-heading">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-prose">
      <Eyebrow>Available now</Eyebrow>
      <h2 id="packages-heading" class="mt-4 text-h2">
        Land and a fixed-price home, in one number.
      </h2>
      <p class="mt-5 text-lead text-ink-70">
        Every package shows the land price and the build price separately.
      </p>
    </div>

    <a class="section-link" href="/house-and-land/">
      View all packages
      <Icon name="arrow-right" size={18} />
    </a>
  </div>

  <div
    class="tabs"
    data-estates-filter
    role="group"
    aria-label="Filter packages by estate"
  >
    {
      estateTabs.map((estate) => (
        <button
          class="tab"
          type="button"
          data-filter-value={estate.id}
          data-filter-label={estate.name}
          aria-pressed={estate.id === DEFAULT_ESTATE ? 'true' : 'false'}
        >
          <span class="tab-name">{estate.name}</span>
          <span class="num tab-suburb">{estate.suburb}</span>
        </button>
      ))
    }
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-packages-status></p>

  <div
    class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    data-packages-grid
    data-reveal-group
  >
    {
      featured.map((pkg) => (
        <PackageCard
          pkg={pkg}
          designName={designName.get(pkg.design) ?? pkg.design}
          estateName={estateName.get(pkg.estate) ?? null}
          hidden={pkg.estate !== DEFAULT_ESTATE}
        />
      ))
    }
  </div>

  <p class="mt-8 max-w-prose text-small text-ink-55">
    Correct at publication. Subject to change. Land is sold under a separate contract with
    the developer.
  </p>
</Section>

<style>
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
  }

  .tab {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-height: 52px;
    padding: 0.5rem 1.125rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    background-color: transparent;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    scroll-snap-align: start;
    transition:
      background-color var(--duration-micro) var(--ease-out),
      color var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out);
  }

  .tab-name {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .tab-suburb {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-55);
  }

  .tab:hover {
    border-color: var(--color-ink);
  }

  .tab[aria-pressed='true'] {
    background-color: var(--color-teal);
    border-color: var(--color-teal);
    color: var(--color-surface);
  }

  .tab[aria-pressed='true'] .tab-suburb {
    color: rgb(255 255 255 / 0.7);
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .section-link :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .section-link:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
