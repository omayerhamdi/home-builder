---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import Certainty from '../components/sections/Certainty.astro';
import Tiers from '../components/sections/Tiers.astro';
import Designs from '../components/sections/Designs.astro';
import Packages from '../components/sections/Packages.astro';
import BuildZones from '../components/sections/BuildZones.astro';
import Display from '../components/sections/Display.astro';
import Reviews from '../components/sections/Reviews.astro';
import FirstHome from '../components/sections/FirstHome.astro';
import Process from '../components/sections/Process.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
---

<BaseLayout
  title="Fixed Price House & Land in Melbourne's West | DBN Homes"
  description="Fixed price, full turnkey homes across Melbourne's western growth corridor. Landscaping, fencing and driveway included. Packages from $524,105. Display open 7 days."
  overHero
>
  <Hero />
  <ProofStrip />
  <Certainty />
  <Tiers />
  <Designs />
  <Packages />
  <BuildZones />
  <Display />
  <Reviews />
  <FirstHome />
  <Process />
  <ClosingCta />
</BaseLayout>
