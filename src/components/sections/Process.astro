---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const steps = [
  {
    title: 'Enquiry and consultation',
    body: 'We look at your block, your budget and which designs actually fit.',
  },
  {
    title: 'Tender',
    body: 'A full fixed price, including site costs. 5% deposit on acceptance.',
  },
  {
    title: 'Colour selection',
    body: 'You choose finishes, colours, lighting and electrical with a design consultant.',
  },
  {
    title: 'Contract',
    body: 'HIA plain-English contract, plans and the energy assessment. Signed within 180 days of your deposit.',
  },
  {
    title: 'Permits',
    body: 'Planning approval where the council requires it, then the building permit.',
  },
  {
    title: 'Construction',
    body: 'With a site supervisor you can call directly.',
  },
  {
    title: 'Handover',
    body: 'Keys, and a completed home with the landscaping and fencing already done.',
  },
  {
    title: 'Maintenance',
    body: 'Six months from settlement, then a licensed inspection at twelve.',
  },
];
---

<Section id="build-process" band="surface" labelledby="process-heading">
  <div class="max-w-prose">
    <Eyebrow>From enquiry to keys</Eyebrow>
    <h2 id="process-heading" class="mt-4 text-h2">
      Eight steps. You'll know which one you're on.
    </h2>
  </div>

  <ol class="steps" data-reveal-group>
    {
      steps.map((step, i) => (
        <li class="step" data-reveal>
          <p class="num step-number">{String(i + 1).padStart(2, '0')}</p>
          <p class="mt-3 text-h3">{step.title}</p>
          <p class="mt-2 text-small text-ink-70">{step.body}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    gap: 1px;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    background-color: var(--color-rule);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    padding: 1.5rem;
    background-color: var(--color-surface);
  }

  .step-number {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-brick);
  }
</style>
