---
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import posterWide from '../../assets/img/hero/hero-poster.jpg';
import posterTall from '../../assets/img/hero/hero-poster-mobile.jpg';
import { site } from '../../lib/site';

/**
 * Hero.
 *
 * The poster is the LCP element, always — the video is layered over it and is
 * only fetched above 768px and only when motion is allowed. Below that
 * breakpoint the visitor gets a still image and none of the megabytes, on
 * exactly the connection where that matters most.
 *
 * The scrim is two layers rather than one flat wash: a diagonal that seats the
 * headline and a bottom lift that seats the finder bar. Measured against the
 * brightest frame of this footage, the headline clears 7:1.
 */

const widths = [640, 960, 1280, 1600, 2000];

const wideAvif = await getImage({
  src: posterWide,
  widths,
  format: 'avif',
  quality: 46,
});
const wideWebp = await getImage({
  src: posterWide,
  widths,
  format: 'webp',
  quality: 62,
});
const tallAvif = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'avif',
  quality: 46,
});
const tallWebp = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'webp',
  quality: 62,
});

const posterAlt =
  'A completed DBN home on its lot in a Melbourne growth-corridor estate, seen from the air with the driveway, fencing and landscaping finished';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media">
    <picture>
      <source
        media="(max-width: 767px)"
        type="image/avif"
        srcset={tallAvif.srcSet.attribute}
        sizes="100vw"
      />
      <source
        media="(max-width: 767px)"
        type="image/webp"
        srcset={tallWebp.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes="100vw" />
      <img
        class="hero-img"
        src={wideWebp.src}
        width={posterWide.width}
        height={posterWide.height}
        alt={posterAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <video
      class="hero-video"
      data-hero-video
      data-src-mp4="/video/dbn-display-home.mp4"
      data-src-webm="/video/dbn-display-home.webm"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>

    <div class="hero-scrim"></div>
  </div>

  <div class="hero-inner">
    <div class="mx-auto flex w-full max-w-content flex-col px-gutter">
      <p class="hero-eyebrow num">Melbourne's west · Display open 7 days</p>

      <h1 id="hero-heading" class="hero-title mt-5">
        The price we quote is the price you pay.
      </h1>

      <p class="hero-sub mt-6">
        Fixed price, full turnkey homes across Melbourne's western growth corridor. Site
        costs, landscaping, fencing and driveway are already in the number — and we hold
        that number for <span class="num">18</span> months.
      </p>

      <div class="hero-actions mt-8">
        <Button href="/house-and-land/" tone="dark" icon="arrow-right">
          Browse packages
        </Button>
        <Button href="/build-a-quote/" variant="secondary" tone="dark"
          >Build a quote</Button
        >
      </div>
    </div>
  </div>

  <!-- Package finder, docked to the bottom edge of the hero -->
  <div class="hero-finder">
    <div class="mx-auto max-w-content px-gutter">
      <form class="finder" data-package-finder>
        <p class="finder-label" id="finder-label">Find a package</p>

        <div class="finder-fields" role="group" aria-labelledby="finder-label">
          <div class="finder-field">
            <label for="finder-region">Region</label>
            <select id="finder-region" name="region">
              <option value="">Any region</option>
              <option value="melbourne-west">Melbourne West</option>
              <option value="melbourne-north">Melbourne North</option>
              <option value="melbourne-south-east">South East</option>
              <option value="geelong">Geelong</option>
              <option value="ballarat">Ballarat</option>
              <option value="gippsland">Gippsland</option>
            </select>
          </div>

          <div class="finder-field">
            <label for="finder-beds">Bedrooms</label>
            <select id="finder-beds" name="beds">
              <option value="">Any</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>
          </div>

          <div class="finder-field">
            <label for="finder-price">Budget</label>
            <select id="finder-price" name="price">
              <option value="">Any</option>
              <option value="0-600000">Under $600k</option>
              <option value="600000-650000">$600k – $650k</option>
              <option value="650000-700000">$650k – $700k</option>
              <option value="700000-999999">$700k and above</option>
            </select>
          </div>

          <button class="finder-submit" type="submit">
            Show packages
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </form>
    </div>
  </div>

  <p class="sr-only">
    Call {site.name} on {site.phone}.
  </p>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(560px, 74svh, 760px);
    padding-top: var(--spacing-header);
    color: var(--color-surface);
    isolation: isolate;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--spacing-header-lg);
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--color-forest-deep);
  }

  .hero-img,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-image) var(--ease-out);
  }

  .hero-video[data-playing] {
    opacity: 1;
  }

  /* Two layers, not one flat wash: a diagonal that seats the headline and a
     bottom lift that seats the finder bar. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgb(22 33 31 / 0.78) 0%,
        rgb(22 33 31 / 0.42) 55%,
        rgb(22 33 31 / 0.18) 100%
      ),
      linear-gradient(to top, rgb(22 33 31 / 0.88) 0%, rgb(22 33 31 / 0) 58%);
  }

  .hero-inner {
    display: flex;
    flex: 1;
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-limestone);
  }

  .hero-title {
    max-width: 16ch;
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 30rem;
  }

  @media (min-width: 640px) {
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      max-width: none;
    }
  }

  .hero-sub {
    max-width: 54ch;
    font-size: var(--text-lead);
    color: rgb(255 255 255 / 0.88);
  }

  /* --------------------------------------------------------------------
     Package finder
  -------------------------------------------------------------------- */
  .hero-finder {
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .finder {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-float);
  }

  @media (min-width: 768px) {
    .finder {
      padding: 1.5rem;
    }
  }

  .finder-label {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-55);
  }

  .finder-fields {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.875rem;
  }

  @media (min-width: 640px) {
    .finder-fields {
      grid-template-columns: repeat(3, 1fr);
    }

    .finder-submit {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .finder-fields {
      grid-template-columns: repeat(3, 1fr) auto;
      align-items: end;
    }

    .finder-submit {
      grid-column: auto;
    }
  }

  .finder-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .finder-field label {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .finder-field select {
    height: 52px;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-small);
  }

  .finder-field select:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 2px;
  }

  .finder-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 52px;
    padding-inline: 1.5rem;
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--color-forest);
    color: var(--color-surface);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .finder-submit:hover {
    background-color: var(--color-forest-lift);
  }
</style>

<script>
  /* The video is an enhancement layered over the poster: fetched only above
     768px, only when motion is allowed, and never on the critical path. */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const wide = window.matchMedia('(min-width: 768px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function loadHeroVideo() {
    if (!video || video.dataset.loaded || !wide.matches || reduced.matches) return;
    video.dataset.loaded = 'true';

    for (const [type, attr] of [
      ['video/webm', 'srcWebm'],
      ['video/mp4', 'srcMp4'],
    ] as const) {
      const src = video.dataset[attr];
      if (!src) continue;
      const source = document.createElement('source');
      source.type = type;
      source.src = src;
      video.append(source);
    }

    video.load();
    video.addEventListener('playing', () => video.setAttribute('data-playing', ''), {
      once: true,
    });
    void video.play().catch(() => {
      /* Autoplay refused — the poster stays, which is the intended fallback. */
    });
  }

  if (wide.matches) {
    if ('requestIdleCallback' in window) window.requestIdleCallback(loadHeroVideo);
    else loadHeroVideo();
  }
  wide.addEventListener('change', loadHeroVideo);
</script>
