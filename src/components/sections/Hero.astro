---
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import CornerTick from '../ui/CornerTick.astro';
import PackageFinder from './PackageFinder.astro';
import posterWide from '../../assets/img/hero/hero-poster.jpg';
import posterTall from '../../assets/img/hero/hero-poster-mobile.jpg';

/**
 * Hero — a site plan, not a billboard.
 *
 * The film no longer sits behind the words. It gets its own cell in a
 * four-part grid, which fixes the headline contrast problem at source and lets
 * the footage play at full fidelity with no overlay at all.
 *
 *   ┌───────────────────────────┬──────────┐
 *   │ A · Claim      cols 1–7   │ B · Video│
 *   ├───────────────────────────┤ cols 8–12│
 *   │ C · Finder     cols 1–7   │ rows 1–2 │
 *   └───────────────────────────┴──────────┘
 *
 * The header above is the same teal as cell A and sits flush against it, so
 * the two read as one dark block. The proof strip is a sibling section below,
 * so it can go full-bleed.
 *
 * DOM order is the reading order at every width — no CSS `order` anywhere, so
 * the screen-reader sequence never diverges from the visual one.
 */

const wideAvif = await getImage({
  src: posterWide,
  widths: [640, 960, 1280, 1600],
  format: 'avif',
  quality: 50,
});
const wideWebp = await getImage({
  src: posterWide,
  widths: [640, 960, 1280, 1600],
  format: 'webp',
  quality: 64,
});
const tallAvif = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'avif',
  quality: 50,
});
const tallWebp = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'webp',
  quality: 64,
});

const posterAlt =
  'Open-plan dining and kitchen in a completed DBN display home — island bench, timber-look flooring and a stone splashback';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <!-- A · Claim -->
    <div class="cell cell-claim">
      <CornerTick tone="dark" />

      <p class="hero-eyebrow num">Melbourne's west · Display open 7 days</p>

      <h1 id="hero-heading" class="hero-title">
        The price we quote is the price you pay.
      </h1>

      <p class="hero-sub">
        Fixed price, full turnkey. Site costs, landscaping and fencing are already in the
        number.
      </p>

      <div class="hero-actions">
        <Button href="/house-and-land/" tone="dark" icon="arrow-right">
          Browse packages
        </Button>
        <Button href="/build-a-quote/" variant="secondary" tone="dark"
          >Build a quote</Button
        >
      </div>
    </div>

    <!-- B · Video -->
    <div class="cell cell-video">
      <CornerTick tone="dark" />

      <picture>
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={tallAvif.srcSet.attribute}
          sizes="100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={tallWebp.srcSet.attribute}
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset={wideAvif.srcSet.attribute}
          sizes="(min-width: 1024px) 42vw, 100vw"
        />
        <source
          type="image/webp"
          srcset={wideWebp.srcSet.attribute}
          sizes="(min-width: 1024px) 42vw, 100vw"
        />
        <img
          class="hero-img"
          src={wideWebp.src}
          width={posterWide.width}
          height={posterWide.height}
          alt={posterAlt}
          loading="eager"
          decoding="async"
        />
      </picture>

      <video
        class="hero-video"
        data-hero-video
        data-src-mp4="/video/dbn-display-home.mp4"
        data-src-webm="/video/dbn-display-home.webm"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"></video>
    </div>

    <!-- C · Finder -->
    <div class="cell cell-finder">
      <PackageFinder />
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-teal-deep);
  }

  .hero-grid {
    display: grid;
    gap: 16px;
    max-width: var(--container-content);
    margin-inline: auto;
    padding: 0 var(--spacing-gutter) var(--spacing-gutter);
  }

  /* The section may exceed the viewport on short screens — cells are never
     compressed to force a fit. */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto;
      min-height: clamp(
        600px,
        calc(100svh - var(--spacing-header-lg) - var(--spacing-gutter)),
        840px
      );
    }

    .cell-claim {
      grid-column: 1 / 8;
      grid-row: 1;
    }

    .cell-video {
      grid-column: 8 / -1;
      grid-row: 1 / 3;
    }

    .cell-finder {
      grid-column: 1 / 8;
      grid-row: 2;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-grid {
      min-height: clamp(
        560px,
        calc(100svh - var(--spacing-header) - var(--spacing-gutter)),
        880px
      );
    }
  }

  .cell {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* ------------------------------------------------------------- A · Claim */
  .cell-claim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 4vw, 56px);
    background-color: var(--color-teal);
    /* A hairline on three sides. The top edge stays open so the cell still
       runs into the header as one block. */
    border-inline: 1px solid rgb(255 255 255 / 0.09);
    border-bottom: 1px solid rgb(255 255 255 / 0.09);
    color: var(--color-surface);
  }

  .hero-eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-limestone);
  }

  .hero-title {
    max-width: 15ch;
    margin-top: 1.125rem;
    /* 32px → 52px. Deliberately capped: above this it stops being a headline
       and starts being a wall. */
    font-size: clamp(2rem, 1.1rem + 2.8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    max-width: 42ch;
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    opacity: 0.82;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-actions :global(a) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .hero-actions :global(a) {
      width: auto;
    }
  }

  /* ------------------------------------------------------------- B · Video */
  .cell-video {
    background-color: var(--color-teal-deep);
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 1024px) {
    .cell-video {
      aspect-ratio: auto;
    }
  }

  .hero-img,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-image) var(--ease-out);
  }

  .hero-video[data-playing] {
    opacity: 1;
  }

  /* ------------------------------------------------------------ C · Finder */
  .cell-finder {
    background-color: var(--color-surface);
  }

  /* --------------------------------------------------------------- Mobile
     Gaps, radii and cell edges all go: at this width they add noise rather
     than structure, and the three cells read better as one continuous run. */
  @media (max-width: 767px) {
    .hero-grid {
      gap: 0;
      padding: 0;
      max-width: none;
    }

    .cell {
      border-radius: 0;
    }

    .cell-claim {
      padding: clamp(28px, 7vw, 40px) var(--spacing-gutter) clamp(32px, 8vw, 44px);
      border: 0;
    }

    /* Height, not aspect-ratio: capping the height of an aspect-ratio box
       shrinks its width too, which left a strip of teal beside the film. */
    .cell-video {
      aspect-ratio: auto;
      height: clamp(260px, 46svh, 420px);
    }
  }
</style>

<script>
  /* The video is an enhancement over the poster: fetched only above 768px,
     only when motion is allowed, and only on idle. */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const wide = window.matchMedia('(min-width: 768px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function loadHeroVideo() {
    if (!video || video.dataset.loaded || !wide.matches || reduced.matches) return;
    video.dataset.loaded = 'true';

    for (const [type, attr] of [
      ['video/webm', 'srcWebm'],
      ['video/mp4', 'srcMp4'],
    ] as const) {
      const src = video.dataset[attr];
      if (!src) continue;
      const source = document.createElement('source');
      source.type = type;
      source.src = src;
      video.append(source);
    }

    video.load();
    video.addEventListener('playing', () => video.setAttribute('data-playing', ''), {
      once: true,
    });
    void video.play().catch(() => {
      /* Autoplay refused — the poster stays, which is the intended fallback. */
    });
  }

  if (wide.matches) {
    if ('requestIdleCallback' in window) window.requestIdleCallback(loadHeroVideo);
    else loadHeroVideo();
  }
  wide.addEventListener('change', loadHeroVideo);
</script>
