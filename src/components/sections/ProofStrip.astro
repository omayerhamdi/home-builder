---
import Icon, { type IconName } from '../ui/Icon.astro';
import { site } from '../../lib/site';

/**
 * Four facts, hairline separated. Value and label only — no sentences.
 *
 * The job is to remove doubt in three seconds, so the values are set large in
 * the display face, the numbers are mono, and each cell carries one small
 * icon. Nothing here is decoration and every claim is checkable.
 */
interface Item {
  icon: IconName;
  value: string;
  label: string;
  mono: boolean;
  stars?: boolean;
}

const items: Item[] = [
  { icon: 'shield-check', value: 'HIA', label: 'Member', mono: false },
  {
    icon: 'star',
    value: String(site.rating.value),
    label: `${site.rating.count} Google reviews`,
    mono: true,
    stars: true,
  },
  { icon: 'clock', value: '18 months', label: 'Price held', mono: true },
  { icon: 'wrench', value: '6 months', label: 'Maintenance after handover', mono: true },
];
---

<section class="proof" aria-label="Credentials">
  <div class="mx-auto max-w-content px-gutter">
    <ul class="proof-grid" data-reveal-group>
      {
        items.map((item) => (
          <li class="proof-item" data-reveal>
            <Icon name={item.icon} size={20} class="proof-icon" />
            <p class:list={['proof-value', item.mono && 'num']}>{item.value}</p>
            <p class="proof-label">
              {item.stars && (
                <span class="proof-stars" aria-hidden="true">
                  <Icon name="star" size={12} strokeWidth={0} class="proof-star" />
                  <Icon name="star" size={12} strokeWidth={0} class="proof-star" />
                  <Icon name="star" size={12} strokeWidth={0} class="proof-star" />
                  <Icon name="star" size={12} strokeWidth={0} class="proof-star" />
                  <Icon name="star" size={12} strokeWidth={0} class="proof-star" />
                </span>
              )}
              {item.label}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    background-color: var(--color-limestone);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background-color: var(--color-limestone-deep);
  }

  @media (min-width: 900px) {
    .proof-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2vw, 1.75rem);
    background-color: var(--color-limestone);
  }

  .proof-item :global(.proof-icon) {
    color: var(--color-forest);
    opacity: 0.65;
  }

  .proof-value {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .proof-value.num {
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
  }

  .proof-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-70);
  }

  .proof-stars {
    display: inline-flex;
    gap: 1px;
    color: var(--color-brick);
  }

  .proof-stars :global(.proof-star) {
    fill: currentColor;
  }
</style>
