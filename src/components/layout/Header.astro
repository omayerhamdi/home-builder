---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import Icon from '../ui/Icon.astro';
import { buildPrimaryNav } from '../../lib/nav';
import { navFeature } from '../../lib/images';
import { site } from '../../lib/site';

/**
 * Site header.
 *
 * Sticky rather than fixed, so it sits in normal flow and no page has to
 * reserve space for it. On the homepage it is `tone="teal"` and sits flush
 * against the hero's claim cell with no gap and no border — header and cell
 * read as one dark block. Everywhere else it is a white bar with a hairline.
 *
 * Above 1024px the navigation is horizontal with mega menus; below that it
 * moves into a drawer.
 */
interface Props {
  tone?: 'surface' | 'teal';
}

const { tone = 'surface' } = Astro.props;
const primaryNav = await buildPrimaryNav();
---

<header class:list={['site-header', `tone-${tone}`]} data-header>
  <div class="header-bar">
    <div
      class="mx-auto flex h-header max-w-content items-center gap-4 px-gutter lg:h-header-lg"
    >
      <a
        href="/"
        class="header-logo shrink-0 rounded-sm"
        aria-label={`${site.name} — home`}
      >
        <Logo height={32} loading="eager" class="lg:!h-[38px]" />
      </a>

      <nav aria-label="Primary" class="header-nav">
        <ul class="flex items-center gap-1">
          {
            primaryNav.map((item, i) =>
              item.panel ? (
                <li class="nav-item" data-nav-item>
                  <button
                    type="button"
                    class="nav-link"
                    aria-expanded="false"
                    aria-controls={`mega-${i}`}
                    data-nav-trigger
                  >
                    {item.label}
                    <Icon name="chevron-down" size={15} class="nav-chevron" />
                  </button>

                  <div id={`mega-${i}`} class="mega" data-nav-panel hidden>
                    <div class="mega-inner">
                      <div
                        class="mega-columns"
                        style={`--mega-cols:${item.panel.columns.length}`}
                      >
                        {item.panel.columns.map((column) => (
                          <div class="mega-column">
                            <p class="mega-heading">{column.heading}</p>
                            <ul class="mega-list">
                              {column.links.map((link) => (
                                <li>
                                  <a class="mega-link" href={link.href}>
                                    <span class="mega-link-label">{link.label}</span>
                                    {link.note && (
                                      <span class="num mega-link-note">{link.note}</span>
                                    )}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      <div class="mega-feature">
                        {/* Named explicitly: without this the link picks up the
                            image alt, the heading, the derived line and the CTA
                            as one run-on string. The alt stays meaningful for
                            anyone browsing images. */}
                        <a
                          class="mega-card"
                          href={item.panel.promo.cta.href}
                          aria-label={`${item.panel.promo.heading} ${item.panel.promo.cta.label}`}
                        >
                          <span class="mega-card-media">
                            <Picture
                              src={navFeature(item.panel.promo.image).src}
                              alt={navFeature(item.panel.promo.image).alt}
                              formats={['avif']}
                              fallbackFormat="webp"
                              widths={[400, 800]}
                              sizes="(min-width: 1280px) 400px, 340px"
                              quality={55}
                              class="mega-card-image"
                              loading="lazy"
                              decoding="async"
                            />
                          </span>
                          <span class="mega-card-heading">
                            {item.panel.promo.heading}
                          </span>
                          <span class="num mega-card-body">{item.panel.promo.body}</span>
                          <span class="mega-card-cta">
                            {item.panel.promo.cta.label}
                            <Icon name="arrow-right" size={16} />
                          </span>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a class="nav-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-2 lg:ml-6 lg:gap-3">
        <a class="header-phone num" href={site.phoneHref}>
          <Icon name="phone" size={16} />
          {site.phone}
        </a>
        <a class="header-cta" href="/build-a-quote/">Build a quote</a>
        <button
          type="button"
          class="header-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <Icon name="menu" size={22} />
          <span class="sr-only">Open menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mega-backdrop" data-nav-backdrop hidden></div>
</header>

<MobileNav nav={primaryNav} />

<style>
  /* --------------------------------------------------------------------
     Bar
  -------------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .tone-surface .header-bar {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Flush against the hero's claim cell — no border, no gap, one dark block. */
  .tone-teal {
    background-color: var(--color-teal);
    color: var(--color-surface);
  }

  .tone-teal .header-bar {
    background-color: var(--color-teal);
  }

  .tone-teal .header-logo :global(img) {
    filter: brightness(0) invert(1);
  }

  .header-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: block;
      margin-left: auto;
    }
  }

  /* --------------------------------------------------------------------
     Bar links
  -------------------------------------------------------------------- */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity var(--duration-micro) var(--ease-out);
  }

  .nav-link:hover {
    opacity: 0.72;
  }

  /* The open item carries a rule under its label, so the bar shows which panel
     is down. It sits on the link's own bottom edge, not the header's — the
     item has to stay `position: static` for the panel below to span the
     viewport, which rules out measuring against the bar. */
  .nav-link[aria-expanded='true'] {
    opacity: 1;
  }

  .nav-item .nav-link {
    position: relative;
  }

  .nav-link[aria-expanded='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.375rem;
    height: 2px;
    background-color: currentcolor;
  }

  /* One chevron, rotated. Not two icons swapped — a single rotated mark is
     what Elementor's nav widget renders, so this is the version that ports. */
  .nav-link :global(.nav-chevron) {
    flex: none;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-item:hover .nav-link :global(.nav-chevron),
  .nav-item:focus-within .nav-link :global(.nav-chevron),
  .nav-link[aria-expanded='true'] :global(.nav-chevron) {
    transform: rotate(180deg);
  }

  .nav-item {
    position: static;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-phone:hover {
    opacity: 0.72;
  }

  @media (min-width: 1024px) {
    .header-phone {
      display: inline-flex;
    }
  }

  .header-cta {
    display: none;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-teal);
    color: var(--color-surface);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .header-cta:hover {
    background-color: var(--color-teal-lift);
  }

  @media (min-width: 768px) {
    .header-cta {
      display: inline-flex;
    }
  }

  .tone-teal .header-cta {
    background-color: var(--color-surface);
    color: var(--color-teal);
  }

  .tone-teal .header-cta:hover {
    background-color: var(--color-limestone);
  }

  .header-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }

  .tone-teal .header-toggle {
    border-color: rgb(255 255 255 / 0.35);
  }

  @media (min-width: 1024px) {
    .header-toggle {
      display: none;
    }
  }

  /* --------------------------------------------------------------------
     Mega menu.

     Two bays: link columns on the left, one picture on the right. The right
     bay is tinted and bleeds to the viewport edge while its contents stay on
     the 1200px grid — that is what makes the panel read as part of the page
     rather than as a floating card. The bleed is done with asymmetric padding
     (`--mega-bleed`) rather than a pseudo-element, so there is exactly one box
     to reason about at every width.

     Columns keep their hairlines: two lists side by side must never read as
     one, and at three columns the rules are doing real work.
  -------------------------------------------------------------------- */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    /* Half the leftover space beside the content container, never less than the
       gutter, so the link columns land on the same grid as the page below.
       It has to sit here, on the full-width box: a percentage in a padding
       resolves against the element's own containing block, and on a grid item
       that is the track, not the bar. There is no right padding — the picture
       bay is meant to run off the edge. */
    padding-left: max(var(--spacing-gutter), calc((100% - var(--container-content)) / 2));
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
    box-shadow: var(--shadow-float);
    color: var(--color-ink);
  }

  .mega[hidden] {
    display: none;
  }

  .mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, clamp(19rem, 27vw, 26rem));
  }

  .mega-columns {
    display: grid;
    grid-template-columns: repeat(var(--mega-cols, 2), minmax(0, 1fr));
    column-gap: 2.5rem;
    padding: 2.25rem 2.5rem 2.75rem 0;
  }

  /* The picture bay, tinted and running to the right edge of the viewport. */
  .mega-feature {
    padding: 2.25rem clamp(1.5rem, 3vw, 2.5rem) 2.75rem;
    background-color: var(--color-teal-tint);
    border-left: 1px solid var(--color-rule);
  }

  .mega-column + .mega-column {
    padding-left: 2.5rem;
    border-left: 1px solid var(--color-rule);
  }

  .mega-heading {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mega-list {
    display: flex;
    flex-direction: column;
    margin-top: 0.25rem;
  }

  .mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-small);
    text-decoration: none;
    transition:
      padding-left var(--duration-micro) var(--ease-out),
      background-color var(--duration-micro) var(--ease-out);
  }

  .mega-list li:last-child .mega-link {
    border-bottom: 0;
  }

  .mega-link:hover {
    padding-left: 0.75rem;
    background-color: var(--color-paper);
  }

  .mega-link-label {
    font-weight: 500;
  }

  .mega-link-note {
    flex: none;
    font-size: 0.75rem;
    color: var(--color-ink-55);
    letter-spacing: 0.02em;
  }

  /* One card, one picture. The whole thing is a single anchor, so there is one
     tab stop and one hit target rather than an overlay chasing a link. */
  .mega-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .mega-card-media {
    display: block;
    overflow: hidden;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-md);
    /* Holds the box while the image decodes, so the panel never reflows as it
       opens — the menu is the one place a layout shift is unforgivable. */
    aspect-ratio: 16 / 9;
    background-color: var(--color-limestone);
  }

  /* `<Picture>` emits a <picture> wrapper, which is inline by default — without
     this the img sizes itself and the aspect-ratio box above it does nothing. */
  .mega-card-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mega-card-media :global(.mega-card-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-image) var(--ease-out);
  }

  .mega-card:hover .mega-card-media :global(.mega-card-image) {
    transform: scale(1.03);
  }

  .mega-card-heading {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .mega-card-body {
    font-size: var(--text-small);
    color: var(--color-ink-70);
  }

  .mega-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mega-card-cta :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .mega-card:hover .mega-card-cta :global(svg) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-card-media :global(.mega-card-image),
    .mega-card-cta :global(svg) {
      transition: none;
    }

    .mega-card:hover .mega-card-media :global(.mega-card-image),
    .mega-card:hover .mega-card-cta :global(svg) {
      transform: none;
    }
  }

  .mega-backdrop {
    position: fixed;
    inset: 0;
    top: var(--spacing-header-lg);
    background-color: rgb(18 38 42 / 0.28);
    z-index: -1;
  }

  .mega-backdrop[hidden] {
    display: none;
  }
</style>

<script>
  import '../../scripts/nav';
</script>
