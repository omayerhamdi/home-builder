---
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import Icon from '../ui/Icon.astro';
import { buildPrimaryNav } from '../../lib/nav';
import { site } from '../../lib/site';

/**
 * Site header.
 *
 * Sticky rather than fixed, so it sits in normal flow and no page has to
 * reserve space for it. On the homepage it is `tone="forest"` and sits flush
 * against the hero's claim cell with no gap and no border — header and cell
 * read as one dark block. Everywhere else it is a white bar with a hairline.
 *
 * Above 1024px the navigation is horizontal with mega menus; below that it
 * moves into a drawer.
 */
interface Props {
  tone?: 'surface' | 'forest';
}

const { tone = 'surface' } = Astro.props;
const primaryNav = await buildPrimaryNav();
---

<header class:list={['site-header', `tone-${tone}`]} data-header>
  <div class="header-bar">
    <div
      class="mx-auto flex h-header max-w-wide items-center gap-4 px-gutter lg:h-header-lg"
    >
      <a
        href="/"
        class="header-logo shrink-0 rounded-sm"
        aria-label={`${site.name} — home`}
      >
        <Logo height={32} loading="eager" class="lg:!h-[38px]" />
      </a>

      <nav aria-label="Primary" class="header-nav">
        <ul class="flex items-center gap-1">
          {
            primaryNav.map((item, i) =>
              item.panel ? (
                <li class="nav-item" data-nav-item>
                  <button
                    type="button"
                    class="nav-link"
                    aria-expanded="false"
                    aria-controls={`mega-${i}`}
                    data-nav-trigger
                  >
                    {item.label}
                    <Icon name="chevron-down" size={15} class="nav-chevron" />
                  </button>

                  <div id={`mega-${i}`} class="mega" data-nav-panel hidden>
                    <div class="mega-inner">
                      <div
                        class="mega-columns"
                        style={`--mega-cols:${item.panel.columns.length}`}
                      >
                        {item.panel.columns.map((column) => (
                          <div class="mega-column">
                            <p class="mega-heading">{column.heading}</p>
                            <ul class="mega-list">
                              {column.links.map((link) => (
                                <li>
                                  <a class="mega-link" href={link.href}>
                                    <span class="mega-link-label">{link.label}</span>
                                    {link.note && (
                                      <span class="num mega-link-note">{link.note}</span>
                                    )}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      <div class="mega-promo">
                        <p class="mega-promo-heading">{item.panel.promo.heading}</p>
                        <p class="num mega-promo-body">{item.panel.promo.body}</p>
                        <span class="mega-promo-cta">
                          {item.panel.promo.cta.label}
                          <Icon name="arrow-right" size={16} />
                        </span>
                        <a class="mega-promo-hit" href={item.panel.promo.cta.href}>
                          <span class="sr-only">{item.panel.promo.cta.label}</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a class="nav-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-2 lg:ml-6 lg:gap-3">
        <a class="header-phone num" href={site.phoneHref}>
          <Icon name="phone" size={16} />
          {site.phone}
        </a>
        <a class="header-cta" href="/build-a-quote/">Build a quote</a>
        <button
          type="button"
          class="header-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <Icon name="menu" size={22} />
          <span class="sr-only">Open menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mega-backdrop" data-nav-backdrop hidden></div>
</header>

<MobileNav nav={primaryNav} />

<style>
  /* --------------------------------------------------------------------
     Bar
  -------------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .tone-surface .header-bar {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Flush against the hero's claim cell — no border, no gap, one dark block. */
  .tone-forest {
    background-color: var(--color-forest);
    color: var(--color-surface);
  }

  .tone-forest .header-bar {
    background-color: var(--color-forest);
  }

  .tone-forest .header-logo :global(img) {
    filter: brightness(0) invert(1);
  }

  .header-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: block;
      margin-left: auto;
    }
  }

  /* --------------------------------------------------------------------
     Bar links
  -------------------------------------------------------------------- */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity var(--duration-micro) var(--ease-out);
  }

  .nav-link:hover {
    opacity: 0.72;
  }

  /* One chevron, rotated. Not two icons swapped — a single rotated mark is
     what Elementor's nav widget renders, so this is the version that ports. */
  .nav-link :global(.nav-chevron) {
    flex: none;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-item:hover .nav-link :global(.nav-chevron),
  .nav-item:focus-within .nav-link :global(.nav-chevron),
  .nav-link[aria-expanded='true'] :global(.nav-chevron) {
    transform: rotate(180deg);
  }

  .nav-item {
    position: static;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-phone:hover {
    opacity: 0.72;
  }

  @media (min-width: 1024px) {
    .header-phone {
      display: inline-flex;
    }
  }

  .header-cta {
    display: none;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-forest);
    color: var(--color-surface);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .header-cta:hover {
    background-color: var(--color-forest-lift);
  }

  @media (min-width: 768px) {
    .header-cta {
      display: inline-flex;
    }
  }

  .tone-forest .header-cta {
    background-color: var(--color-surface);
    color: var(--color-forest);
  }

  .tone-forest .header-cta:hover {
    background-color: var(--color-limestone);
  }

  .header-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }

  .tone-forest .header-toggle {
    border-color: rgb(255 255 255 / 0.35);
  }

  @media (min-width: 1024px) {
    .header-toggle {
      display: none;
    }
  }

  /* --------------------------------------------------------------------
     Mega menu — columns separated by real hairlines, each heading on its own
     rule, so two lists side by side can never read as one.
  -------------------------------------------------------------------- */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
    box-shadow: var(--shadow-float);
    color: var(--color-ink);
  }

  .mega[hidden] {
    display: none;
  }

  .mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 2.5rem;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 2.25rem var(--spacing-gutter) 2.5rem;
  }

  .mega-columns {
    display: grid;
    grid-template-columns: repeat(var(--mega-cols, 2), minmax(0, 1fr));
    column-gap: 2.5rem;
  }

  .mega-column + .mega-column {
    padding-left: 2.5rem;
    border-left: 1px solid var(--color-rule);
  }

  .mega-heading {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mega-list {
    display: flex;
    flex-direction: column;
    margin-top: 0.25rem;
  }

  .mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-small);
    text-decoration: none;
    transition:
      padding-left var(--duration-micro) var(--ease-out),
      background-color var(--duration-micro) var(--ease-out);
  }

  .mega-list li:last-child .mega-link {
    border-bottom: 0;
  }

  .mega-link:hover {
    padding-left: 0.75rem;
    background-color: var(--color-paper);
  }

  .mega-link-label {
    font-weight: 500;
  }

  .mega-link-note {
    flex: none;
    font-size: 0.75rem;
    color: var(--color-ink-55);
    letter-spacing: 0.02em;
  }

  .mega-promo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: start;
    gap: 0.5rem;
    padding: 1.75rem;
    border-radius: var(--radius-md);
    background-color: var(--color-limestone);
  }

  .mega-promo-heading {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .mega-promo-body {
    font-size: var(--text-small);
    color: var(--color-ink-70);
  }

  .mega-promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mega-promo-cta :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .mega-promo:hover .mega-promo-cta :global(svg) {
    transform: translateX(3px);
  }

  .mega-promo-hit {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .mega-backdrop {
    position: fixed;
    inset: 0;
    top: var(--spacing-header-lg);
    background-color: rgb(22 33 31 / 0.28);
    z-index: -1;
  }

  .mega-backdrop[hidden] {
    display: none;
  }
</style>

<script>
  import '../../scripts/nav';
</script>
