---
/**
 * Lucide icons, inlined as SVG at build time. No icon font, no runtime
 * library, no emoji. Every icon is either paired with a visible label or
 * given a `label` prop that becomes its accessible name.
 */
interface Props {
  name: IconName;
  size?: number;
  /** Accessible name. Omit when the icon sits beside visible text. */
  label?: string;
  class?: string;
}

const paths = {
  phone: [
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
  ],
  'arrow-right': ['M5 12h14', 'm12 5 7 7-7 7'],
  'arrow-up-right': ['M7 7h10v10', 'M7 17 17 7'],
  menu: ['M4 6h16', 'M4 12h16', 'M4 18h16'],
  x: ['M18 6 6 18', 'm6 6 12 12'],
  'chevron-down': ['m6 9 6 6 6-6'],
  check: ['M20 6 9 17l-5-5'],
  clock: ['M12 6v6l4 2'],
  'map-pin': [
    'M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0',
  ],
  'shield-check': [
    'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
    'm9 12 2 2 4-4',
  ],
  sun: [
    'M12 2v2',
    'M12 20v2',
    'm4.93 4.93 1.41 1.41',
    'm17.66 17.66 1.41 1.41',
    'M2 12h2',
    'M20 12h2',
    'm6.34 17.66-1.41 1.41',
    'm19.07 4.93-1.41 1.41',
  ],
} as const;

const circles = {
  clock: [{ cx: 12, cy: 12, r: 10 }],
  'map-pin': [{ cx: 12, cy: 10, r: 3 }],
  sun: [{ cx: 12, cy: 12, r: 4 }],
} as const;

export type IconName = keyof typeof paths;

const { name, size = 20, label, class: className = '' } = Astro.props;
const shapes: readonly string[] = paths[name];
const dots: readonly { cx: number; cy: number; r: number }[] =
  name in circles ? circles[name as keyof typeof circles] : [];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {dots.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
  {shapes.map((d) => <path d={d} />)}
</svg>
