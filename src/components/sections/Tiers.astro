---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import smartSpecsImage from '../../assets/img/interiors/kitchen-galley.jpg';
import luxeImage from '../../assets/img/interiors/kitchen-island.jpg';

/**
 * The two specifications, side by side.
 *
 * Nobody else in this segment explains their tiers on the homepage — the
 * client's own site does not name them at all — so this section is doing work
 * no competitor is doing.
 */
const tiers = (await getCollection('tiers')).sort(
  (a, b) => a.data.priceFrom - b.data.priceFrom,
);

const art = {
  smartspecs: {
    image: smartSpecsImage,
    alt: 'Galley kitchen in a SmartSpecs home — stone benchtops, stainless appliances and timber-look flooring',
  },
  luxeturnkey: {
    image: luxeImage,
    alt: 'Kitchen and island bench in a LuxeTurnkey home — dark overhead cabinetry, 900mm cooktop and canopy rangehood',
  },
} as const;
---

<Section id="finish" band="surface" labelledby="finish-heading">
  <div class="max-w-prose">
    <Eyebrow>Two specifications</Eyebrow>
    <h2 id="finish-heading" class="mt-4 text-h2">
      Pick the level of finish. The price stays fixed either way.
    </h2>
    <p class="mt-5 text-lead text-ink-70">
      Every DBN home is <span class="num">7</span>-star energy rated with solar as
      standard. The difference between our two specifications is how much is already done
      when you walk in.
    </p>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-8" data-reveal-group>
    {
      tiers.map((tier) => {
        const media = art[tier.id as keyof typeof art];
        return (
          <article class="tier" data-reveal>
            <Picture
              src={media.image}
              alt={media.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 45vw, 100vw"
              quality={58}
              class="tier-image"
              loading="lazy"
              decoding="async"
            />

            <div class="tier-body">
              <p class="text-eyebrow font-semibold uppercase tracking-[0.14em] text-ink-55">
                {tier.data.tagline}
              </p>
              <h3 class="mt-3 text-h3">{tier.data.name}</h3>

              <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
                <span class="num text-h3 font-medium">{tier.data.priceFromLabel}</span>
                <span class="text-small text-ink-55">{tier.data.priceFromSubLabel}</span>
              </p>

              <p class="mt-3 text-body text-ink-70">{tier.data.summary}</p>

              <p class="mt-7 text-eyebrow font-semibold uppercase tracking-[0.14em] text-ink-55">
                {tier.data.inheritsFrom ? 'Everything in SmartSpecs, plus' : 'Included'}
              </p>

              <ul class="mt-4 flex flex-col gap-3">
                {tier.data.inclusions.map((inclusion) => (
                  <li class="flex gap-2.5 text-small">
                    <Icon name="check" size={16} class="mt-1 shrink-0 text-forest" />
                    <span>{inclusion}</span>
                  </li>
                ))}
              </ul>

              <Button class="mt-8" href={tier.data.cta.href} icon="arrow-right" full>
                {tier.data.cta.label}
              </Button>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="mt-8">
    <a class="schedule-link" href="/inclusions/#schedule">
      Full inclusions schedule (PDF)
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</Section>

<style>
  .tier {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .tier:hover {
    border-color: var(--color-rule-strong);
  }

  .tier-image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tier-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .tier-body :global(ul) {
    flex: 1;
  }

  .schedule-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
