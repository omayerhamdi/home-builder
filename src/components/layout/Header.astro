---
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import Icon from '../ui/Icon.astro';
import { primaryNav, site } from '../../lib/site';

/**
 * Site header.
 *
 * Above 1024px it is a full horizontal bar with mega menus. Below that the
 * navigation moves into a drawer — a right-hand panel on tablets, full width
 * on phones. On pages with a hero the bar starts transparent and turns solid
 * on scroll; everywhere else it is solid from the first paint.
 */
interface Props {
  /** True on pages whose first section is a full-bleed hero. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
---

<header
  class="site-header fixed inset-x-0 top-0 z-50"
  data-header
  data-over-hero={overHero ? '' : undefined}
>
  <div class="header-bar border-b">
    <div
      class="mx-auto flex h-header max-w-wide items-center gap-4 px-gutter lg:h-header-lg"
    >
      <a
        href="/"
        class="header-logo shrink-0 rounded-sm"
        aria-label={`${site.name} — home`}
      >
        <Logo height={32} class="lg:!h-[38px]" />
      </a>

      <!-- Desktop navigation -->
      <nav aria-label="Primary" class="ml-auto hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            primaryNav.map((item, i) =>
              item.panel ? (
                <li class="nav-item" data-nav-item>
                  <button
                    type="button"
                    class="nav-link inline-flex items-center gap-1.5"
                    aria-expanded="false"
                    aria-controls={`mega-${i}`}
                    data-nav-trigger
                  >
                    {item.label}
                    <Icon
                      name="chevron-down"
                      size={16}
                      class="nav-chevron transition-transform duration-base ease-out"
                    />
                  </button>

                  <div id={`mega-${i}`} class="mega" data-nav-panel hidden>
                    <div class="mx-auto grid max-w-wide gap-x-10 gap-y-8 px-gutter py-10 lg:grid-cols-12">
                      <div
                        class:list={[
                          'grid gap-x-10 gap-y-8',
                          item.panel.columns.length > 2
                            ? 'lg:col-span-8 sm:grid-cols-3'
                            : 'lg:col-span-8 sm:grid-cols-2',
                        ]}
                      >
                        {item.panel.columns.map((column) => (
                          <div>
                            <p class="text-eyebrow font-semibold uppercase tracking-[0.14em] text-ink-55">
                              {column.heading}
                            </p>
                            <ul class="mt-4 flex flex-col gap-0.5">
                              {column.links.map((link) => (
                                <li>
                                  <a class="mega-link" href={link.href}>
                                    <span>{link.label}</span>
                                    {link.note && (
                                      <span class="num text-small text-ink-55">
                                        {link.note}
                                      </span>
                                    )}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      <div class="mega-promo lg:col-span-4">
                        <p class="text-h3">{item.panel.promo.heading}</p>
                        <p class="mt-2 text-small text-ink-70">{item.panel.promo.body}</p>
                        <a class="mega-promo-cta mt-5" href={item.panel.promo.cta.href}>
                          {item.panel.promo.cta.label}
                          <Icon name="arrow-right" size={16} />
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a class="nav-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-2 lg:ml-6 lg:gap-3">
        <a class="header-phone num hidden lg:inline-flex" href={site.phoneHref}>
          <Icon name="phone" size={16} />
          {site.phone}
        </a>
        <a class="header-cta hidden md:inline-flex" href="/build-a-quote/">
          Build a quote
        </a>
        <button
          type="button"
          class="header-toggle lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <Icon name="menu" size={22} />
          <span class="sr-only">Open menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mega-backdrop" data-nav-backdrop hidden></div>
</header>

<MobileNav />

<style>
  /* --------------------------------------------------------------------
     Bar
  -------------------------------------------------------------------- */
  .header-bar {
    background-color: var(--color-surface);
    border-color: var(--color-rule);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  /* Over a hero the bar is transparent until the page scrolls or a mega
     menu opens. `color-scheme` here is the header's own, not the user's. */
  .site-header[data-over-hero]:not([data-solid]) .header-bar {
    background-color: transparent;
    border-color: transparent;
  }

  .site-header[data-over-hero]:not([data-solid]) {
    color: var(--color-surface);
  }

  .site-header[data-over-hero]:not([data-solid]) .header-logo :global(img) {
    filter: brightness(0) invert(1);
  }

  /* --------------------------------------------------------------------
     Links
  -------------------------------------------------------------------- */
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--duration-micro) var(--ease-out);
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  .nav-item {
    position: static;
  }

  [data-nav-trigger][aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
  }

  .header-phone {
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-phone:hover {
    opacity: 0.7;
  }

  .header-cta {
    align-items: center;
    justify-content: center;
    min-height: 44px;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-forest);
    color: var(--color-surface);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .header-cta:hover {
    background-color: var(--color-forest-lift);
  }

  .site-header[data-over-hero]:not([data-solid]) .header-cta {
    background-color: var(--color-surface);
    color: var(--color-forest);
  }

  .site-header[data-over-hero]:not([data-solid]) .header-cta:hover {
    background-color: var(--color-limestone);
  }

  .header-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .header-toggle {
      display: none;
    }
  }

  .site-header[data-over-hero]:not([data-solid]) .header-toggle {
    border-color: rgb(255 255 255 / 0.35);
  }

  /* --------------------------------------------------------------------
     Mega menu
  -------------------------------------------------------------------- */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-rule);
    box-shadow: var(--shadow-float);
    color: var(--color-ink);
  }

  .mega[hidden] {
    display: none;
  }

  .mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.375rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    text-decoration: none;
    transition: background-color var(--duration-micro) var(--ease-out);
  }

  .mega-link:hover {
    background-color: var(--color-paper);
  }

  .mega-promo {
    align-self: start;
    background-color: var(--color-limestone);
    padding: 1.75rem;
    border-radius: var(--radius-md);
  }

  .mega-promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mega-backdrop {
    position: fixed;
    inset: 0;
    top: var(--spacing-header-lg);
    background-color: rgb(22 33 31 / 0.24);
    z-index: -1;
  }

  .mega-backdrop[hidden] {
    display: none;
  }
</style>

<script>
  import '../../scripts/nav';
</script>
