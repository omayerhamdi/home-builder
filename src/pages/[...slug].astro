---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { facadeImage } from '../lib/images';
import { formatAud, packageFromPrice } from '../lib/format';
import { footerNav, legalNav, site } from '../lib/site';
import { buildPrimaryNav } from '../lib/nav';

/**
 * Route stubs.
 *
 * This phase ships the homepage. Every other destination the homepage links to
 * still resolves to a real page with real metadata rather than a 404, so the
 * navigation can be walked end to end in front of the client.
 *
 * Titles, descriptions and Open Graph images are generated per route type —
 * package routes get their own record's figures and façade image — so the
 * metadata layer is already correct when these pages are built out.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const [designs, packages, estates] = await Promise.all([
    getCollection('designs'),
    getCollection('packages'),
    getCollection('estates'),
  ]);
  const primaryNav = await buildPrimaryNav();
  const estateName = new Map(estates.map((e) => [e.data.id, e.data]));
  const designName = new Map(designs.map((d) => [d.data.id, d.data.name]));

  const fromNav = [
    ...primaryNav.flatMap((item) => [
      item.href,
      ...(item.panel?.columns.flatMap((column) => column.links.map((l) => l.href)) ?? []),
      ...(item.panel ? [item.panel.promo.cta.href] : []),
    ]),
    ...footerNav.flatMap((column) => column.links.map((l) => l.href)),
    ...legalNav.map((l) => l.href),
    '/build-a-quote/',
    '/first-home-buyers/',
    '/display-homes/',
    '/contact/',
    '/gallery/',
  ];

  const routes = new Set<string>();
  for (const href of fromNav) {
    const path = href.split('?')[0]!.split('#')[0]!;
    if (path && path !== '/') routes.add(path);
  }

  const paths = [...routes].map((route) => ({
    params: { slug: route.replace(/^\/|\/$/g, '') },
    props: {} as Record<string, unknown>,
  }));

  for (const design of designs) {
    paths.push({
      params: { slug: `home-designs/${design.data.id}` },
      props: {
        title: `${design.data.name} — ${design.data.frontage}m frontage | ${site.name}`,
        description: `${design.data.bedrooms} bed, ${design.data.bathrooms} bath, ${design.data.cars} car ${design.data.name} on a ${design.data.frontage}m frontage. ${design.data.squares} squares, single storey, fixed price with site costs included.`,
      },
    });
  }

  for (const entry of packages) {
    const pkg = entry.data;
    const estate = estateName.get(pkg.estate);
    const name = designName.get(pkg.design) ?? pkg.design;
    paths.push({
      params: { slug: `house-and-land/${pkg.id}` },
      props: {
        title: `${name} — Lot ${pkg.lot} ${estate?.name ?? ''}, ${pkg.suburb} | ${site.name}`,
        description: `${pkg.bedrooms} bed, ${pkg.bathrooms} bath, ${pkg.cars} car ${name} on ${pkg.landSizeM2}m² at ${estate?.name ?? pkg.suburb}, ${pkg.suburb}. Fixed price from ${formatAud(packageFromPrice(pkg))} including land.${pkg.titleDate ? ` Title ${pkg.titleDate}.` : ' Titled now.'}`,
        facade: pkg.image,
      },
    });
  }

  return paths;
};

const { slug } = Astro.params;
const {
  title: propTitle,
  description: propDescription,
  facade,
} = Astro.props as { title?: string; description?: string; facade?: string };

/** Per-section metadata for the routes that already have specified copy. */
const known: Record<string, { title: string; description: string }> = {
  'house-and-land': {
    title: `House & Land Packages, Melbourne West | ${site.name}`,
    description:
      "Fixed-price house and land packages in Melbourne's western growth corridor. Landscaping, fencing and driveway included. Filter by estate, budget and block size.",
  },
  'home-designs': {
    title: `Home Designs, 8.5m to 16m Frontage | ${site.name}`,
    description:
      'Five series, thirteen single-storey designs built around a frontage width. Fixed price with site costs included, 7-star energy rating and solar as standard.',
  },
  inclusions: {
    title: `SmartSpecs and LuxeTurnkey Inclusions | ${site.name}`,
    description:
      'Two levels of finish, one fixed price. Compare what is included in SmartSpecs and LuxeTurnkey, plus the façade range and the full inclusions schedule.',
  },
};

const label = (slug ?? '')
  .split('/')
  .pop()!
  .replace(/-/g, ' ')
  .replace(/^./, (c) => c.toUpperCase());

const fallback = known[slug ?? ''];
const title = propTitle ?? fallback?.title ?? `${label} | ${site.name}`;
const description =
  propDescription ??
  fallback?.description ??
  "Fixed price, full turnkey homes in Melbourne's west. Landscaping, fencing and driveway included. This section is scheduled for the next stage of the build.";

/* Package routes carry their own façade as the share image. */
const ogImage = facade
  ? (
      await getImage({
        src: facadeImage(facade),
        width: 1200,
        height: 630,
        fit: 'cover',
        format: 'jpeg',
        quality: 72,
      })
    ).src
  : undefined;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <section class="bg-paper py-section" aria-labelledby="stub-heading">
    <div class="mx-auto max-w-content px-gutter">
      <Eyebrow>Next stage of the build</Eyebrow>
      <h1 id="stub-heading" class="mt-4 max-w-[20ch] text-h1">{label}</h1>

      <div class="mt-6 flex max-w-prose flex-col gap-4 text-lead text-ink-70">
        <p>
          This prototype covers the homepage in full. The House &amp; Land listing, the
          single package page and the rest of the site are scoped, designed and scheduled
          — they are not built yet, so this route exists to keep the navigation walkable
          rather than to hold placeholder content.
        </p>
        <p>
          Everything you can already see — the design tokens, the components, the data
          layer and the price breakdown — is what these pages will be assembled from.
        </p>
      </div>

      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="/" icon="arrow-right">Back to the homepage</Button>
        <Button href={site.phoneHref} variant="secondary">
          Call <span class="num">{site.phone}</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
