---
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import posterWide from '../../assets/img/hero/hero-poster.jpg';
import posterTall from '../../assets/img/hero/hero-poster-mobile.jpg';

/**
 * Hero.
 *
 * Two different compositions, not one shrunk down.
 *
 * Below 768px the film and the words are separated: a 4:5 media block, then a
 * solid forest panel carrying the headline. Nothing is set over moving video
 * on a phone, so the type is at full contrast and the copy does not have to
 * fight a scrim that changes brightness every frame.
 *
 * From 768px up the film goes full-bleed behind the words, with a three-layer
 * scrim — a heavy left wash to seat the column, a base lift, and a soft
 * vignette. The poster is always the LCP element; the video is fetched only
 * above 768px, only when motion is allowed, and only on idle.
 */

const wideAvif = await getImage({
  src: posterWide,
  widths: [960, 1280, 1600, 2000],
  format: 'avif',
  quality: 46,
});
const wideWebp = await getImage({
  src: posterWide,
  widths: [960, 1280, 1600, 2000],
  format: 'webp',
  quality: 62,
});
const tallAvif = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'avif',
  quality: 48,
});
const tallWebp = await getImage({
  src: posterTall,
  widths: [540, 720, 1080],
  format: 'webp',
  quality: 64,
});

const posterAlt =
  'Aerial view of a DBN home on its lot in a Melbourne growth-corridor estate, driveway, fencing and landscaping complete';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media">
    <picture>
      <source
        media="(max-width: 767px)"
        type="image/avif"
        srcset={tallAvif.srcSet.attribute}
        sizes="100vw"
      />
      <source
        media="(max-width: 767px)"
        type="image/webp"
        srcset={tallWebp.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes="100vw" />
      <img
        class="hero-img"
        src={wideWebp.src}
        width={posterWide.width}
        height={posterWide.height}
        alt={posterAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <video
      class="hero-video"
      data-hero-video
      data-src-mp4="/video/dbn-display-home.mp4"
      data-src-webm="/video/dbn-display-home.webm"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>

    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content">
    <div class="hero-inner">
      <p class="hero-eyebrow num">Melbourne's west · Display open 7 days</p>

      <h1 id="hero-heading" class="hero-title">
        The price we quote is the price you pay.
      </h1>

      <p class="hero-sub">
        Fixed price, full turnkey. Site costs, landscaping and fencing are already in the
        number.
      </p>

      <div class="hero-actions">
        <Button href="/house-and-land/" tone="dark" icon="arrow-right">
          Browse packages
        </Button>
        <Button href="/build-a-quote/" variant="glass" tone="dark">Build a quote</Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------
     Mobile: media block, then a solid panel. No type over video.
  -------------------------------------------------------------------- */
  .hero {
    display: flex;
    flex-direction: column;
    background-color: var(--color-forest);
    color: var(--color-surface);
    isolation: isolate;
  }

  .hero-media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 46svh;
    overflow: hidden;
    background-color: var(--color-forest-deep);
  }

  .hero-img,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-image) var(--ease-out);
  }

  .hero-video[data-playing] {
    opacity: 1;
  }

  /* On mobile the scrim only has to blend the image into the panel below. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(22 33 31 / 0.28) 0%,
      rgb(22 33 31 / 0) 34%,
      rgb(31 59 50 / 0.55) 88%,
      var(--color-forest) 100%
    );
  }

  .hero-content {
    padding-block: clamp(2rem, 7vw, 3rem) clamp(2.5rem, 8vw, 3.5rem);
  }

  .hero-inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .hero-eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-limestone);
  }

  .hero-title {
    max-width: 15ch;
    margin-top: 1rem;
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    color: rgb(255 255 255 / 0.86);
  }

  /* Full-width stacked buttons on the narrowest screens: a two-up row wraps
     the label onto a second line, which reads as a mistake. */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-actions :global(a) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .hero-actions :global(a) {
      width: auto;
    }
  }

  /* --------------------------------------------------------------------
     768px and up: film behind the words.
  -------------------------------------------------------------------- */
  @media (min-width: 768px) {
    .hero {
      position: relative;
      justify-content: flex-end;
      min-height: clamp(560px, 82svh, 800px);
      padding-top: var(--spacing-header);
      background-color: transparent;
    }

    .hero-media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      max-height: none;
      z-index: -1;
    }

    /* Three layers. The left wash seats the copy column, the base lift seats
       the section edge, and the vignette stops the corners going flat. */
    .hero-scrim {
      background:
        linear-gradient(
          100deg,
          rgb(16 26 24 / 0.88) 0%,
          rgb(16 26 24 / 0.72) 34%,
          rgb(16 26 24 / 0.28) 68%,
          rgb(16 26 24 / 0.12) 100%
        ),
        linear-gradient(to top, rgb(16 26 24 / 0.72) 0%, rgb(16 26 24 / 0) 46%),
        radial-gradient(
          120% 90% at 70% 30%,
          rgb(16 26 24 / 0) 40%,
          rgb(16 26 24 / 0.4) 100%
        );
    }

    .hero-content {
      display: flex;
      flex: 1;
      align-items: center;
      padding-block: clamp(3rem, 7vw, 5rem);
    }

    .hero-inner {
      width: 100%;
    }

    .hero-title {
      max-width: 14ch;
    }

    .hero-sub {
      max-width: 42ch;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--spacing-header-lg);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const wide = window.matchMedia('(min-width: 768px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function loadHeroVideo() {
    if (!video || video.dataset.loaded || !wide.matches || reduced.matches) return;
    video.dataset.loaded = 'true';

    for (const [type, attr] of [
      ['video/webm', 'srcWebm'],
      ['video/mp4', 'srcMp4'],
    ] as const) {
      const src = video.dataset[attr];
      if (!src) continue;
      const source = document.createElement('source');
      source.type = type;
      source.src = src;
      video.append(source);
    }

    video.load();
    video.addEventListener('playing', () => video.setAttribute('data-playing', ''), {
      once: true,
    });
    void video.play().catch(() => {
      /* Autoplay refused — the poster stays, which is the intended fallback. */
    });
  }

  if (wide.matches) {
    if ('requestIdleCallback' in window) window.requestIdleCallback(loadHeroVideo);
    else loadHeroVideo();
  }
  wide.addEventListener('change', loadHeroVideo);
</script>
