---
import Icon from './Icon.astro';

/**
 * Two-state disclosure indicator.
 *
 * Not one chevron rotated — two marks that cross-fade and slide past each
 * other, so opening and closing read as different states rather than the same
 * glyph tipped over. The pair sits in a small well that fills on hover, which
 * gives the trigger a real target instead of a bare arrow.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 16, class: className = '' } = Astro.props;
---

<span class:list={['disclosure', className]} aria-hidden="true">
  <span class="disclosure-layer is-closed">
    <Icon name="chevron-down" size={size} />
  </span>
  <span class="disclosure-layer is-open">
    <Icon name="chevron-up" size={size} />
  </span>
</span>

<style>
  .disclosure {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.625rem;
    height: 1.625rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out),
      color var(--duration-micro) var(--ease-out);
  }

  .disclosure-layer {
    grid-area: 1 / 1;
    display: inline-flex;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .is-open {
    opacity: 0;
    transform: translateY(5px);
  }

  /* Hover nudges the closed chevron down — the affordance answers before the
     click does. */
  :where(button, a, summary):hover .disclosure {
    background-color: rgb(22 33 31 / 0.07);
    border-color: var(--color-rule);
  }

  :where(button, a, summary):hover .is-closed {
    transform: translateY(1px);
  }

  :where([aria-expanded='true']) .disclosure {
    background-color: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-surface);
  }

  :where([aria-expanded='true']) .is-closed {
    opacity: 0;
    transform: translateY(-5px);
  }

  :where([aria-expanded='true']) .is-open {
    opacity: 1;
    transform: none;
  }
</style>
